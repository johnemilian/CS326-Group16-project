# Copy this file to .env and fill in real values. .env is git-ignored; never commit it.

# MongoDB connection string. Inside the Gantry container the host is "mongo";
# with MongoDB running directly on your machine, use localhost instead.
MONGODB_URI=mongodb://dev:devpassword@mongo:27017/group16?authSource=admin

# Signs the session cookie. Use a long random string, different on every machine. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional. Defaults to 3000.
# PORT=3000
