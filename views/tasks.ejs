<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <link rel="stylesheet" href="/output.css">
  </head>
  <body>
    <%- include('partials/header') %>
    <main>
      <form class="class-form flex flex-wrap mb-6 gap-2" id="task-form">
        <input class="form-input flex-2" type="text" name="title" placeholder="Title">
        <input class="form-input flex-1" type="date" name="deadline" aria-label="Deadline">
        <%# 'resize' in following textarea element to allow resize along both axes to override default which is resize:vertical only %>
        <textarea class="form-input resize basis-full" name="description" placeholder="Description"></textarea>
        <input class="form-input flex-1" type="text" name="station" placeholder="Station">
        <input class="form-input flex-1" type="text" name="assigner" placeholder="Assigner">
        <input class="form-input flex-1" type="text" name="assignee" placeholder="Assignee">
        <input class="form-input max-sm:basis-full sm:flex-1" type="text" name="prerequisites" placeholder="Prerequisites">
        <button class="btn ml-auto bg-sky-700 text-sky-50 border-0" type="submit">Add task</button>
      </form>
      <ul class="flex flex-col gap-3 p-0 list-none" id="tasks">
        <% tasks.forEach((task) => { %>
          <%- include('partials/task', { task }) %>
        <% }); %>
      </ul>
    </main>
    <script src="/app.js" defer></script>
  </body>
</html>
