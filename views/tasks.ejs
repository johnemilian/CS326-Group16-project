<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <link rel="stylesheet" href="/output.css">
  </head>
  <body>
    <%- include('partials/header') %>
    <main>
      <form class="class-form flex flex-wrap mb-6 gap-2" id="task-form">
        <input class="form-input flex-2" type="text" name="title" placeholder="Title">
        <input class="form-input flex-1" type="date" name="deadline" aria-label="Deadline">
        <%# 'resize' in following textarea element to allow resize along both axes to override default which is resize:vertical only %>
        <textarea class="form-input resize basis-full" name="description" placeholder="Description"></textarea>
        <input class="form-input flex-1" type="text" name="station" placeholder="Station">
        <input class="form-input flex-1" type="text" name="assigner" placeholder="Assigner">
        <input class="form-input flex-1" type="text" name="assignee" placeholder="Assignee">
        <input class="form-input max-sm:basis-full sm:flex-1" type="text" name="prerequisites" placeholder="Prerequisites">
        <button class="btn ml-auto bg-sky-700 text-sky-50 border-0" type="submit">Add task</button>
      </form>
      <ul class="flex flex-col gap-3 p-0 list-none" id="tasks">
        <% tasks.forEach((task) => { %>
          <% const details = [["Station", task.station], ["Assigner", task.assigner], ["Assignee", task.assignee], ["Deadline", task.deadline], ["Prerequisites", task.prerequisites]].filter(([, value]) => value); %>
          <li class="group/task-card flex justify-between items-center gap-2 p-3 border-2 border-gray-200 rounded-sm" data-id="<%= task.id %>" data-title="<%= task.title %>" data-description="<%= task.description %>" data-station="<%= task.station %>" data-assigner="<%= task.assigner %>" data-assignee="<%= task.assignee %>" data-deadline="<%= task.deadline %>" data-prerequisites="<%= task.prerequisites %>" data-priority="<%= task.priority %>">
            <span class="task-display flex-1"><strong><%= task.title %>:</strong> <%= task.description %><% if (details.length) { %><small class="block mt-1 text-gray-600"><%= details.map(([label, value]) => `${label}: ${value}`).join(" · ") %></small><% } %></span>
            <button class="priority-btn btn border border-amber-600 text-amber-600 group-data-[priority=true]/task-card:text-amber-50 group-data-[priority=true]/task-card:bg-amber-500 group-data-[priority=true]/task-card:uppercase" type="button">Priority</button>
            <button class="edit-btn btn border border-cyan-800 text-cyan-800" type="button">Edit</button>
            <button class="delete-btn btn border border-rose-700 text-rose-700 disabled:opacity-50 disabled:cursor-not-allowed" type="button">Delete</button>
          </li>
        <% }); %>
      </ul>
    </main>
    <script src="/app.js" defer></script>
  </body>
</html>
