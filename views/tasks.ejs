<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <link rel="stylesheet" href="/style.css">
  </head>
  <body>
    <%- include('partials/header') %>
    <main>
      <form id="task-form">
        <input type="text" name="title" placeholder="Title">
        <input type="text" name="description" placeholder="Description">
        <button type="submit">Add task</button>
      </form>
      <ul id="tasks">
        <% tasks.forEach((task) => { %>
          <li data-id="<%= task.id %>" data-title="<%= task.title %>" data-description="<%= task.description %>" data-priority="<%= task.priority %>">
            <span class="task-display"><strong><%= task.title %>:</strong> <%= task.description %></span>
            <button class="priority-btn" type="button">Priority</button>
            <button class="edit-btn" type="button">Edit</button>
            <button class="delete-btn" type="button">Delete</button>
          </li>
        <% }); %>
      </ul>
    </main>
    <script src="/app.js" defer></script>
  </body>
</html>
