<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <link rel="stylesheet" href="/output.css">
  </head>
  <body>
    <%- include('partials/header') %>
    <main>
      <form class="class-form flex flex-wrap mb-6 gap-2" id="task-form">
        <input class="form-input" type="text" name="title" placeholder="Title">
        <input class="form-input" type="text" name="description" placeholder="Description">
        <input class="form-input" type="text" name="station" placeholder="Station">
        <input class="form-input" type="text" name="assigner" placeholder="Assigner">
        <input class="form-input" type="text" name="assignee" placeholder="Assignee">
        <input class="form-input" type="date" name="deadline" aria-label="Deadline">
        <input class="form-input" type="text" name="prerequisites" placeholder="Prerequisites">
        <button class="btn bg-blue-700 text-white border-0" type="submit">Add task</button>
      </form>
      <ul class="flex flex-col gap-3 p-0 list-none" id="tasks">
        <% tasks.forEach((task) => { %>
          <% const details = [["Station", task.station], ["Assigner", task.assigner], ["Assignee", task.assignee], ["Deadline", task.deadline], ["Prerequisites", task.prerequisites]].filter(([, value]) => value); %>
          <li class="flex justify-between items-center gap-2 p-3 border-2 border-gray-200 rounded-sm" data-id="<%= task.id %>" data-title="<%= task.title %>" data-description="<%= task.description %>" data-station="<%= task.station %>" data-assigner="<%= task.assigner %>" data-assignee="<%= task.assignee %>" data-deadline="<%= task.deadline %>" data-prerequisites="<%= task.prerequisites %>" data-priority="<%= task.priority %>">
            <span class="task-display flex-1"><strong><%= task.title %>:</strong> <%= task.description %><% if (details.length) { %><small class="block mt-1 text-gray-600"><%= details.map(([label, value]) => `${label}: ${value}`).join(" · ") %></small><% } %></span>
            <button class="priority-btn btn border border-amber-600 text-amber-600 data-[priority=true]:text-amber-50 data-[priority=true]:bg-amber-600" type="button">Priority</button>
            <button class="edit-btn btn border border-sky-700 text-sky-700" type="button">Edit</button>
            <button class="delete-btn btn border border-rose-600 text-rose-600" type="button">Delete</button>
          </li>
        <% }); %>
      </ul>
    </main>
    <script src="/app.js" defer></script>
  </body>
</html>
