<%# views/manageTasks.ejs %>
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <link rel="stylesheet" href="/output.css">
  </head>
  <body>
    <%- include('partials/header') %>
    <main>
      <%# htmx posts this form to /tasks and appends the returned task card to the end of #tasks.
          The button is disabled while the request is out; the form clears only on success. %>
      <form class="class-form flex flex-wrap mb-6 gap-2" id="task-form"
            hx-post="/tasks" hx-target="#tasks" hx-swap="beforeend"
            hx-disabled-elt="find button"
            hx-on::after-request="if (event.detail.successful) this.reset()"
            hx-on::response-error="alert('Your task was not saved. ' + event.detail.xhr.responseText)"
            hx-on::send-error="alert('Your task was not saved. Could not reach the server.')">

        <div class="flex flex-col flex-2">
          <label for="title" class="text-sm font-medium mb-1">Title</label>
          <input class="form-input" type="text" name="title" id="title" placeholder="Title">
        </div>

        <div class="flex flex-col flex-1">
          <label for="deadline" class="text-sm font-medium mb-1">Deadline</label>
          <input class="form-input" type="date" name="deadline" aria-label="Deadline">
        </div>

        <div class="flex flex-col basis-full">
          <%# 'resize' in following textarea element to allow resize along both axes to override default which is resize:vertical only %>
          <label for="description" class="text-sm font-medium mb-1">Description</label>
          <textarea class="form-input resize-y" name="description" placeholder="Description"></textarea>
        </div>

        <div class="flex flex-col flex-1">
          <label for="station" class="text-sm font-medium mb-1">Station</label>
          <input class="form-input" type="text" name="station" placeholder="Station">
        </div>

        <div class="flex flex-col flex-1">
          <label for="assigner" class="text-sm font-medium mb-1">Assigner</label>
          <input class="form-input" type="text" name="assigner" placeholder="Assigner">
        </div>

        <div class="flex flex-col flex-1">
          <label for="assignee" class="text-sm font-medium mb-1">Assignee</label>
          <input class="form-input" type="text" name="assignee" placeholder="Assignee">
        </div>

        <div class="flex flex-col max-sm:basis-full sm:flex-1">
          <label for="prerequisites" class="text-sm font-medium mb-1">Prerequisites</label>
          <input class="form-input" type="text" name="prerequisites" placeholder="Prerequisites">
        </div>

        <button class="btn ml-auto bg-sky-700 text-sky-50 border-0" type="submit">Add task</button>
      </form>
      <ul class="flex flex-col gap-3 p-0 list-none" id="tasks">
        <% tasks.forEach((task) => { %>
          <%- include('partials/manageTask', { task }) %>
        <% }); %>
      </ul>
    </main>
    <%- include('partials/footer') %>
    <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.10/dist/htmx.min.js"
            integrity="sha384-H5SrcfygHmAuTDZphMHqBJLc3FhssKjG7w/CeCpFReSfwBWDTKpkzPP8c+cLsK+V"
            crossorigin="anonymous"></script>
    <script src="/app.js" defer></script>
  </body>
</html>
